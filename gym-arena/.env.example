# Copy to .env.local (git-ignored). Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Server only — shared with the scheduler (Vercel Cron sends it as `Authorization: Bearer …`); ≥ 16 chars
CRON_SECRET=
# Public origin used in links shown to the admin (e.g. the TV link), e.g. https://arena.example.com
# Optional locally and in staging (empty = the address the page was opened on).
# Required in production: `npm run prod:preflight` fails without it.
APP_ORIGIN=
APP_TIMEZONE=Africa/Cairo
# Server only — Postgres connection for the season-close operation (D27), through the Supabase
# Transaction pooler: postgresql://arena_season_closer.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres
# Must use the restricted role `arena_season_closer`, never the postgres/owner user.
# Created at deployment time; see docs/SECURITY_SPECIFICATION.md §7. Used from M6.
SEASON_CLOSE_DATABASE_URL=

# One-time admin bootstrap (scripts/create-admin.ts)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
