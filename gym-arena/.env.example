# Copy to .env.local (git-ignored). Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
APP_TIMEZONE=Africa/Cairo
# Server only — direct Postgres connection for the season-close operation (D27).
# Must use the restricted role `arena_season_closer`, never the postgres/owner user.
# Created at deployment time; see docs/SECURITY_SPECIFICATION.md §7. Used from M6.
SEASON_CLOSE_DATABASE_URL=

# One-time admin bootstrap (scripts/create-admin.ts)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
