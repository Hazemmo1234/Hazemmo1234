# STAGING operator settings. Copy to .env.staging (git-ignored) on YOUR computer only.
# Never commit real values, never paste them into chat. Every value below comes from the
# STAGING Supabase project — `npm run staging:preflight` refuses anything from production.

# The production project ref (public: the xxxx in https://xxxx.supabase.co). Not a secret.
# Used only to prove that nothing below points at production.
PRODUCTION_SUPABASE_REF=
# Optional: the production public address, so APP_ORIGIN can be checked against it.
PRODUCTION_APP_ORIGIN=

# Staging project → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Staging owner connection (postgres user, Session pooler URI exactly as shown, no ?parameters) —
# used ONLY by `npm run staging:migrate` and `npm run staging:psql`.
# Never put this in the hosting provider.
STAGING_MIGRATION_DATABASE_URL=

# Restricted close role on staging (docs/STAGING.md step 4). Same value goes to the staging host.
SEASON_CLOSE_DATABASE_URL=

# ≥ 16 random characters, different from production. Same value goes to the staging host.
CRON_SECRET=

# Optional. Leave empty to use the staging deployment's own address.
APP_ORIGIN=

# One-time staging admin (npm run staging:create-admin).
# Leave ADMIN_PASSWORD empty: the command asks for it twice without showing it.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
