# PRODUCTION operator settings. Copy to .env.production-ops (git-ignored) on YOUR computer only,
# and only when a production step has been approved (docs/PRODUCTION_RUNBOOK.md).
# Never commit real values, never paste them into chat. This file name is NOT loaded by
# `next build` / `next start` (unlike .env.production), so it cannot leak into a local build.
# `npm run prod:preflight` refuses anything from the staging project.

# The PRODUCTION project ref you operate on (the xxxx in https://xxxx.supabase.co). Not a secret.
PRODUCTION_SUPABASE_REF=
# The STAGING project ref (not a secret) — must appear in no value below.
STAGING_SUPABASE_REF=
# Optional: the staging public address, so APP_ORIGIN can be checked against it.
STAGING_APP_ORIGIN=

# Production project → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Production owner connection (Session pooler URI exactly as shown, no ?parameters) —
# used ONLY by `npm run prod:migrate` and `npm run prod:psql`. Never put this in the hosting provider.
PRODUCTION_MIGRATION_DATABASE_URL=

# Restricted close role on production (Transaction pooler, user arena_season_closer.<ref>, port 6543).
SEASON_CLOSE_DATABASE_URL=

# ≥ 16 random characters, NEW for production (never the staging one).
CRON_SECRET=

# REQUIRED in production: the final public https address, e.g. https://arena.example.com
APP_ORIGIN=

# One-time production admin (npm run prod:create-admin). Leave ADMIN_PASSWORD empty:
# the command asks for it twice without showing it.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
