{
  "name": "gym-arena",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:db": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.db.config.mts",
    "test:e2e": "playwright test --trace off",
    "test:cookies": "vitest run --config vitest.integration.config.mts",
    "db:reset": "supabase db reset",
    "create-admin": "node --env-file-if-exists=.env.local --import tsx scripts/create-admin.ts",
    "staging:preflight": "node scripts/check-node.mjs && node --env-file=.env.staging --import tsx scripts/staging-preflight.ts",
    "staging:migrate": "node scripts/check-node.mjs && node --env-file=.env.staging --import tsx scripts/staging-migrate.ts",
    "staging:psql": "node scripts/check-node.mjs && node --env-file=.env.staging --import tsx scripts/staging-psql.ts",
    "staging:verify": "node scripts/check-node.mjs && node --env-file=.env.staging --import tsx scripts/staging-verify.ts",
    "staging:create-admin": "node scripts/check-node.mjs && node --env-file=.env.staging --import tsx scripts/create-admin.ts --target=staging",
    "staging:backup": "node scripts/check-node.mjs && node --env-file=.env.staging --import tsx scripts/ops-backup.ts",
    "prod:backup": "node scripts/check-node.mjs && node --env-file=.env.production-ops --import tsx scripts/ops-backup.ts --target=production",
    "prod:preflight": "node scripts/check-node.mjs && node --env-file=.env.production-ops --import tsx scripts/staging-preflight.ts --target=production",
    "prod:migrate": "node scripts/check-node.mjs && node --env-file=.env.production-ops --import tsx scripts/staging-migrate.ts --target=production",
    "prod:psql": "node scripts/check-node.mjs && node --env-file=.env.production-ops --import tsx scripts/staging-psql.ts --target=production",
    "prod:verify": "node scripts/check-node.mjs && node --env-file=.env.production-ops --import tsx scripts/staging-verify.ts --target=production",
    "prod:create-admin": "node scripts/check-node.mjs && node --env-file=.env.production-ops --import tsx scripts/create-admin.ts --target=production",
    "test:stack": "bash scripts/test-stack.sh",
    "test:db:isolated": "node -e \"console.error('test:db:isolated is disabled: it used to reset the protected gym-arena-test stack. Write-capable DB tests run in CI on a disposable gym-arena-ci stack (see tests/FIXTURES.md).');process.exit(1)\"",
    "test:e2e:isolated": "node -e \"console.error('test:e2e:isolated is disabled: local browser runs write, and the protected gym-arena-test stack is never a target. Browser tests run in CI only (see tests/FIXTURES.md).');process.exit(1)\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "15.5.29",
    "next-intl": "^4.15.1",
    "postgres": "^4.1.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "fast-check": "^4.10.2",
    "supabase": "^3.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
